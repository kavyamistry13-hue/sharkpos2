# ---------- Server ----------
PORT=4001
NODE_ENV=development
# Comma-separated list of allowed browser origins (dev frontend runs on 5174)
CORS_ORIGIN=http://localhost:5174

# ---------- Database (PostgreSQL) ----------
# Runtime connection: the least-privilege role "sharkpos2_app" (cannot bypass row-level security).
DATABASE_URL=postgres://sharkpos2_app:change-me@localhost:5432/sharkpos2
# Migrations run as the database owner "sharkpos2_owner". Used only by `npm run migrate`.
MIGRATION_DATABASE_URL=postgres://sharkpos2_owner:change-me@localhost:5432/sharkpos2
# Throw-away database for `npm test` (wiped on every run). Must be named sharkpos2_test*
TEST_DATABASE_URL=postgres://sharkpos2_app:change-me@localhost:5432/sharkpos2_test
TEST_MIGRATION_DATABASE_URL=postgres://sharkpos2_owner:change-me@localhost:5432/sharkpos2_test
# NOTE: every database name MUST start with "sharkpos2". The app and scripts refuse anything else, so SHARKPOS 2
# can never be pointed at the original SHARKPOS (hackathon) database.

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Set to true when served over HTTPS (always on in production)
COOKIE_SECURE=false
# COOKIE_DOMAIN=.sharkpos.in

# ---------- Store ----------
STORE_TZ=Asia/Kolkata

# ---------- AI explanation layer (optional) ----------
# The app works fully without these: every AI feature falls back to deterministic, data-driven answers.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000

# ---------- Demo / seed (development only) ----------
# PLATFORM_ADMIN_PASSWORD=platform123
# ALLOW_DEMO=true   # demo reset in production (not recommended)

# ---------- Phase 2 (payments) — not used yet ----------
# razorpay (live/test keys from the Razorpay dashboard) | mock (development/tests only; refused in production) | none
# PAYMENT_PROVIDER=razorpay
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# TRIAL_DAYS=14
# PAST_DUE_GRACE_DAYS=3
# DEFAULT_PLAN=business
