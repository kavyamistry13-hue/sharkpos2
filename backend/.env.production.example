# Production environment variables — NAMES ONLY. Enter real values in the hosting dashboards (Render / Cloudflare / GitHub), never in git.
NODE_ENV=production
CORS_ORIGIN=https://YOUR-PROJECT.pages.dev     # the web app's own address (https)
TRUST_PROXY_HOPS=1
PROXY_SHARED_SECRET=                           # >= 32 chars; identical in Render and Cloudflare Pages
DB_POOL_MAX=5                                  # free databases allow few connections
DATABASE_URL=                                  # Neon DIRECT endpoint (host WITHOUT "-pooler"), role sharkpos2_app, ?sslmode=verify-full
MIGRATION_DATABASE_URL=                        # owner role; used ONLY by the GitHub deploy workflow, never set on Render
JWT_SECRET=                                    # >= 32 chars: openssl rand -hex 48
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# Cloudflare Pages (Settings → Variables and secrets): API_ORIGIN=https://<service>.onrender.com, PROXY_SHARED_SECRET
# Web app build: leave VITE_API_URL EMPTY (the browser talks to the Pages address only; /api is proxied).
# GitHub (environment "production"): secrets RENDER_DEPLOY_HOOK_URL, MIGRATION_DATABASE_URL, BACKUP_DATABASE_URL, BACKUP_PASSPHRASE,
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, BACKUP_VAULT_TOKEN ; variables API_URL, APP_URL, PAGES_PROJECT, BACKUP_VAULT_REPO
